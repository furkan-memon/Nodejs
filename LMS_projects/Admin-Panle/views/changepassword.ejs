<%- include('header') %>

<div class="p-6 lg:p-10 flex items-center justify-center min-h-[70vh]">
    <div class="w-full max-w-md bg-white rounded-[3rem] p-10 shadow-xl border border-slate-50">
        <h2 class="text-2xl font-black text-plum mb-8 text-center">Update Password</h2>
        <form action="/change-password" method="post" class="space-y-6">
            <input type="password" name="oldPass" placeholder="Current Password" class="w-full bg-cloud border-none rounded-2xl px-6 py-4 text-sm font-bold focus:ring-2 focus:ring-plum outline-none">
            <input type="password" name="newPassword" placeholder="New Password" class="w-full bg-cloud border-none rounded-2xl px-6 py-4 text-sm font-bold focus:ring-2 focus:ring-plum outline-none">
            <input type="password" name="confirmPassword" placeholder="Confirm Password" class="w-full bg-cloud border-none rounded-2xl px-6 py-4 text-sm font-bold focus:ring-2 focus:ring-plum outline-none">
            <button type="submit" class="w-full bg-plum text-white py-4 rounded-2xl font-black uppercase text-xs tracking-widest shadow-lg shadow-plum/20 hover:bg-slate-900 transition-all">Update Securely</button>
        </form>
    </div>
</div>

<%- include('footer') %>