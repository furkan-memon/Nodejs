<%- include('header') %>

<div class="min-h-[80vh] flex items-center justify-center p-6">
    <div class="w-full max-w-[420px] bg-white rounded-[3.5rem] p-12 shadow-2xl shadow-plum/10 text-center">
        <div class="w-16 h-16 bg-plum rounded-3xl mx-auto mb-8 flex items-center justify-center text-white text-2xl shadow-lg shadow-plum/30">
            <i class="mdi mdi-lock-reset"></i>
        </div>
        <h2 class="text-3xl font-black text-slate-900 mb-2">Password Reset</h2>
        <p class="text-slate-500 font-medium mb-10">Enter your email to receive a code.</p>
        <form action="/send-otp" method="post" class="space-y-6 text-left">
            <input type="email" name="email" required placeholder="email@domain.com" class="w-full bg-cloud border-none rounded-2xl px-6 py-4 text-sm font-bold focus:ring-2 focus:ring-plum outline-none">
            <button type="submit" class="w-full bg-plum text-white py-4 rounded-2xl font-black uppercase text-xs tracking-widest shadow-xl shadow-plum/20 hover:bg-slate-900 transition-all">Send OTP Code</button>
        </form>
    </div>
</div>

<%- include('footer') %>