<%- include('partials/header') %> <div class="min-h-[80vh] flex items-center justify-center">
    <div class="w-full max-w-[420px] bg-white rounded-[3.5rem] p-12 shadow-2xl shadow-plum/10 border border-slate-100 text-center">
        <div class="w-20 h-20 bg-plum/10 rounded-[2rem] mx-auto mb-8 flex items-center justify-center text-plum text-4xl">
            <i class="mdi mdi-shield-key-outline"></i>
        </div>
        
        <h2 class="text-3xl font-black text-slate-900 mb-2">Security Verification</h2>
        <p class="text-slate-500 font-medium mb-10">We've sent a 6-digit code to your registered email address.</p>

        <form action="/verify-otp" method="post" class="space-y-8">
            <div>
                <label class="text-[10px] font-black text-plum uppercase tracking-[0.3em] block mb-4">Verification Code</label>
                <input type="text" name="otp" required maxlength="6" placeholder="0 0 0 0 0 0" 
                       class="w-full text-center text-3xl font-black tracking-[0.4em] px-4 py-5 rounded-3xl bg-cloud border-4 border-transparent focus:border-plum focus:bg-white outline-none transition-all placeholder:text-slate-200">
            </div>

            <button type="submit" class="w-full bg-plum text-white py-5 rounded-3xl font-black uppercase text-xs tracking-[0.2em] shadow-xl shadow-plum/30 hover:bg-slate-900 active:scale-95 transition-all">
                Authenticate Securely
            </button>
        </form>

        <p class="mt-10 text-xs font-bold text-slate-400">
            Didn't receive a code? <a href="/resend-otp" class="text-plum hover:underline ml-1">Resend SMS</a>
        </p>
    </div>
</div>

<%- include('partials/footer') %>