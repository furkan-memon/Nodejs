<%- include('partials/header') %>

<div class="min-h-[80vh] flex items-center justify-center p-6 bg-cloud">
    <div class="w-full max-w-[450px]">
        
        <div class="text-center mb-10">
            <div class="w-20 h-20 bg-white rounded-[2.5rem] shadow-xl shadow-plum/10 mx-auto mb-6 flex items-center justify-center text-plum text-4xl border border-white">
                <i class="mdi mdi-shield-account-outline"></i>
            </div>
            <h1 class="text-3xl font-black text-slate-900 tracking-tight italic">MATRIX.</h1>
            <p class="text-slate-500 font-bold mt-2 uppercase text-[10px] tracking-[0.3em]">Secure Admin Access</p>
        </div>

        <div class="bg-white rounded-[3.5rem] p-10 md:p-12 shadow-2xl shadow-plum/5 border border-slate-100 relative overflow-hidden">
            
            <div id="loginform">
                <div class="mb-8">
                    <h2 class="text-2xl font-black text-slate-900">Welcome Back</h2>
                    <p class="text-slate-400 text-sm font-semibold">Sign in to continue to dashboard</p>
                </div>

                <form class="space-y-6" action="/login" method="POST">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-plum uppercase tracking-[0.2em] ml-2">Username</label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none text-slate-300 group-focus-within:text-plum transition-colors">
                                <i class="mdi mdi-account-outline text-xl"></i>
                            </div>
                            <input type="text" name="username" required placeholder="admin_user"
                                   class="w-full bg-cloud border-none rounded-2xl py-4 pl-14 pr-6 text-sm font-bold focus:ring-2 focus:ring-plum focus:bg-white outline-none transition-all">
                        </div>
                    </div>

                    <div class="space-y-2">
                        <div class="flex justify-between items-center px-2">
                            <label class="text-[10px] font-black text-plum uppercase tracking-[0.2em]">Password</label>
                            <button type="button" id="to-recover" class="text-[10px] font-black text-slate-400 hover:text-plum uppercase tracking-widest transition-colors">Forgot?</button>
                        </div>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none text-slate-300 group-focus-within:text-plum transition-colors">
                                <i class="mdi mdi-lock-open-outline text-xl"></i>
                            </div>
                            <input type="password" name="password" required placeholder="••••••••"
                                   class="w-full bg-cloud border-none rounded-2xl py-4 pl-14 pr-6 text-sm font-bold focus:ring-2 focus:ring-plum focus:bg-white outline-none transition-all">
                        </div>
                    </div>

                    <button type="submit" class="w-full bg-plum text-white py-5 rounded-[2rem] font-black uppercase text-xs tracking-[0.2em] shadow-xl shadow-plum/30 hover:bg-slate-900 active:scale-95 transition-all flex items-center justify-center gap-3">
                        <span>Authorize Access</span>
                        <i class="mdi mdi-chevron-right text-lg"></i>
                    </button>
                </form>
            </div>

            <div id="recoverform" style="display: none;">
                <div class="mb-8 text-center">
                    <h2 class="text-2xl font-black text-slate-900">Recover Password</h2>
                    <p class="text-slate-400 text-sm font-medium mt-2">Enter your email for a reset link</p>
                </div>

                <form class="space-y-6" action="/recover" method="POST">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-plum uppercase tracking-[0.2em] ml-2">Email Address</label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none text-slate-300 group-focus-within:text-plum transition-colors">
                                <i class="mdi mdi-email-outline text-xl"></i>
                            </div>
                            <input type="email" name="email" required placeholder="admin@matrix.com"
                                   class="w-full bg-cloud border-none rounded-2xl py-4 pl-14 pr-6 text-sm font-bold focus:ring-2 focus:ring-plum focus:bg-white outline-none transition-all">
                        </div>
                    </div>

                    <div class="space-y-4">
                        <button type="submit" class="w-full bg-plum text-white py-5 rounded-[2rem] font-black uppercase text-xs tracking-[0.2em] shadow-xl shadow-plum/30 hover:bg-slate-900 transition-all">
                            Send Reset Link
                        </button>
                        <button type="button" id="to-login" class="w-full text-xs font-black text-slate-400 uppercase tracking-widest hover:text-plum transition-colors">
                            Back to Login
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <p class="text-center mt-10 text-[10px] font-black text-slate-400 uppercase tracking-[0.4em]">
            System Ver: 2.0.4 // Matrix Admin
        </p>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $("#to-recover").on("click", function () {
        $("#loginform").fadeOut(300, function() {
            $("#recoverform").fadeIn(300);
        });
    });

    $("#to-login").click(function () {
        $("#recoverform").fadeOut(300, function() {
            $("#loginform").fadeIn(300);
        });
    });
</script>

<%- include('partials/footer') %>