<!DOCTYPE html>
<html>
<head>
  <title>Admin Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-gray-100 min-h-screen">

  <div class="bg-white shadow-sm">
    <div class="max-w-7xl mx-auto px-8 py-6 flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-bold">Admin Dashboard</h1>
        <p class="text-gray-500 text-sm mt-1">
          Manage your movie collection
        </p>
      </div>

      <a href="/admin/add"
         class="bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700 transition">
         + Add Movie
      </a>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-8 py-10">

    <div class="mb-8">
      <div class="bg-white p-6 rounded-xl shadow flex justify-between items-center">
        <div>
          <p class="text-gray-500 text-sm">Total Movies</p>
          <h2 class="text-2xl font-bold"><%= movies.length %></h2>
        </div>
      </div>
    </div>

    <% if(movies.length === 0){ %>

      <div class="bg-white p-10 rounded-xl shadow text-center">
        <h2 class="text-xl font-semibold mb-2">No Movies Added</h2>
        <p class="text-gray-500 mb-6">
          Start by adding your first movie.
        </p>
        <a href="/admin/add"
           class="bg-green-600 text-white px-6 py-2 rounded-lg">
           Add Movie
        </a>
      </div>

    <% } else { %>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">

        <% movies.forEach(movie => { %>

          <div class="bg-white rounded-xl shadow hover:shadow-xl transition duration-300 overflow-hidden">

            <div class="h-72 bg-gray-200 flex items-center justify-center">
              <% if(movie.poster){ %>
                <img 
                  src="data:image/jpeg;base64,<%= movie.poster.toString('base64') %>"
                  class="max-h-full object-contain">
              <% } else { %>
                <span class="text-gray-400 text-sm">No Poster</span>
              <% } %>
            </div>

            <div class="p-4">

              <h2 class="font-semibold text-lg truncate">
                <%= movie.title %>
              </h2>

              <p class="text-gray-500 text-sm mt-1">
                <%= movie.genre %>
              </p>

              <p class="text-gray-400 text-xs mt-1">
                <%= movie.releaseYear %>
              </p>

              <div class="flex justify-between mt-4">

                <a href="/admin/edit/<%= movie._id %>"
                   class="bg-blue-600 text-white px-3 py-1 rounded-md text-sm hover:bg-blue-700 transition">
                   Edit
                </a>

                <a href="/admin/delete/<%= movie._id %>"
                   onclick="return confirm('Delete this movie?')"
                   class="bg-red-600 text-white px-3 py-1 rounded-md text-sm hover:bg-red-700 transition">
                   Delete
                </a>

              </div>

            </div>

          </div>

        <% }) %>

      </div>

    <% } %>

  </div>

</body>
</html>