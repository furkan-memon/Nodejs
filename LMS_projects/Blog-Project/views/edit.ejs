<%- include("partials/header") %>

<div class="max-w-2xl mx-auto border border-cocoa/20 p-12 rounded-[2rem] bg-white">
  <h2 class="text-4xl font-bold mb-10 tracking-tight">Refine Post</h2>

  <form action="/update/<%= blog._id %>" method="POST" class="space-y-8">
    <div>
      <label class="text-xs font-bold uppercase tracking-widest opacity-40">Headline</label>
      <input name="title" value="<%= blog.title %>" 
             class="w-full text-2xl font-bold border-b border-cocoa/10 focus:border-cocoa outline-none py-2 transition-colors">
    </div>

    <div>
        <label class="text-xs font-bold uppercase tracking-widest opacity-40">Content</label>
        <textarea name="description" rows="6" 
                  class="w-full text-lg leading-relaxed border-none focus:ring-0 outline-none p-0 mt-2"><%= blog.description %></textarea>
    </div>

    <div class="flex gap-4 pt-6">
      <button class="bg-cocoa text-cream px-10 py-4 rounded-full font-bold hover:scale-105 transition-transform">
        Update Story
      </button>
      <a href="/" class="px-10 py-4 font-bold border border-cocoa/20 rounded-full hover:bg-cocoa hover:text-cream transition">
        Discard
      </a>
    </div>
  </form>
</div>

<%- include("partials/footer") %>