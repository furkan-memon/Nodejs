<%- include("partials/header") %>

<div class="flex items-center justify-center min-h-[70vh] px-4">
  <div class="w-full max-w-[400px]">
    <div class="text-center mb-10">
      <h2 class="text-4xl font-bold tracking-tighter mb-2">Welcome Back</h2>
      <p class="text-cocoa/50 text-sm font-medium uppercase tracking-widest">Sign in to your journal</p>
    </div>

    <div class="bg-white border border-cocoa/10 p-8 rounded-[2rem] shadow-xl shadow-cocoa/5">
      <form action="/login" method="POST" class="space-y-6">
        <div>
          <label class="block text-[10px] font-bold uppercase tracking-[0.2em] mb-2 text-cocoa/40">Email Address</label>
          <input name="email" type="email" required placeholder="name@example.com" 
                 class="w-full px-4 py-3 rounded-xl bg-cream/30 border border-cocoa/10 focus:border-cocoa focus:ring-4 focus:ring-cocoa/5 transition-all outline-none">
        </div>
        
        <div>
          <label class="block text-[10px] font-bold uppercase tracking-[0.2em] mb-2 text-cocoa/40">Password</label>
          <input name="password" type="password" required placeholder="••••••••"
                 class="w-full px-4 py-3 rounded-xl bg-cream/30 border border-cocoa/10 focus:border-cocoa focus:ring-4 focus:ring-cocoa/5 transition-all outline-none">
        </div>

        <button class="w-full bg-cocoa text-cream py-4 rounded-xl font-bold uppercase tracking-widest text-xs hover:bg-opacity-90 transition-all transform active:scale-[0.98]">
          Authenticate
        </button>
      </form>

      <div class="mt-8 pt-6 border-t border-cocoa/5 text-center">
        <p class="text-sm text-cocoa/60">
          New here? <a href="/register" class="text-cocoa font-bold hover:underline underline-offset-4">Create account</a>
        </p>
      </div>
    </div>
  </div>
</div>

<%- include("partials/footer") %>