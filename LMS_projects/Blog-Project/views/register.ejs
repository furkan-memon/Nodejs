<%- include("partials/header") %>

<div class="flex items-center justify-center min-h-[80vh] px-4 -mt-12">
  <div class="w-full max-w-[450px] bg-cocoa text-cream rounded-[3rem] p-10 shadow-2xl overflow-hidden relative">
    <div class="absolute top-0 right-0 w-32 h-32 bg-cream/5 rounded-full -mr-16 -mt-16"></div>
    
    <div class="relative z-10">
      <div class="mb-10">
        <h2 class="text-4xl font-bold tracking-tighter mb-2">Join the Collective</h2>
        <p class="text-cream/40 text-xs font-medium uppercase tracking-[0.2em]">Start your writing journey today</p>
      </div>

      <form action="/register" method="POST" class="space-y-6">
        <div>
          <label class="block text-[10px] font-bold uppercase tracking-[0.3em] mb-2 opacity-50">Choose Email</label>
          <input name="email" type="email" required placeholder="you@domain.com" 
                 class="w-full px-4 py-4 rounded-2xl bg-cream/10 border border-cream/10 focus:border-cream focus:bg-transparent transition-all outline-none placeholder:text-cream/20">
        </div>
        
        <div>
          <label class="block text-[10px] font-bold uppercase tracking-[0.3em] mb-2 opacity-50">Set Password</label>
          <input name="password" type="password" required placeholder="Min. 8 characters"
                 class="w-full px-4 py-4 rounded-2xl bg-cream/10 border border-cream/10 focus:border-cream focus:bg-transparent transition-all outline-none placeholder:text-cream/20">
        </div>

        <div class="flex items-center gap-3 py-2">
          <input type="checkbox" required class="rounded bg-cream/10 border-cream/20 text-cream focus:ring-offset-cocoa">
          <span class="text-[10px] uppercase tracking-wider opacity-40">I accept the terms of service</span>
        </div>

        <button class="w-full bg-cream text-cocoa py-4 rounded-2xl font-bold uppercase tracking-widest text-xs hover:bg-opacity-90 transition-all transform active:scale-[0.98]">
          Create Membership
        </button>
      </form>

      <div class="mt-10 text-center">
        <p class="text-xs font-medium opacity-40">
          Already a member? <a href="/login" class="text-cream font-bold hover:underline underline-offset-4 tracking-normal opacity-100 uppercase ml-1">Log in</a>
        </p>
      </div>
    </div>
  </div>
</div>

<%- include("partials/footer") %>