<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Blog App</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            cocoa: '#4B2E2B',
            cream: '#FFF8F0',
          }
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; background-color: #FFF8F0; }
    h1, h2, h3, .logo { font-family: 'Playfair Display', serif; }
  </style>
</head>
<body class="text-cocoa">

<header class="border-b border-cocoa/10 sticky top-0 bg-cream/80 backdrop-blur-md z-50">
  <div class="max-w-5xl mx-auto px-6 h-20 flex items-center justify-between">
    <a href="/" class="logo text-3xl font-bold tracking-tighter">The Blog.</a>
    <nav class="flex gap-8 items-center text-sm font-medium uppercase tracking-widest">
      <a href="/" class="hover:opacity-60 transition">Home</a>
      <a href="/login" class="hover:opacity-60 transition">Login</a>
      <a href="/register" class="bg-cocoa text-cream px-6 py-2 rounded-full hover:bg-opacity-90 transition shadow-lg">Join</a>
    </nav>
  </div>
</header>

<main class="max-w-4xl mx-auto px-6 py-12 min-h-screen">