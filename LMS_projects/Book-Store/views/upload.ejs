<!DOCTYPE html>
<html>
<head>
  <title>Upload Book</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-[#F2E3BB] min-h-screen flex items-center justify-center">

  <div class="bg-white p-8 rounded-xl shadow-lg w-full max-w-lg">

    <h1 class="text-2xl font-semibold text-[#427A43] mb-6 text-center">
      Upload Book
    </h1>

    <form action="/admin/upload" method="POST" enctype="multipart/form-data" class="space-y-4">

      <input type="text" name="name" placeholder="Book Name" required
        class="w-full border p-3 rounded focus:border-[#427A43] outline-none">

      <input type="text" name="authorname" placeholder="Author Name" required
        class="w-full border p-3 rounded focus:border-[#427A43] outline-none">

      <input type="number" name="price" placeholder="Price" required
        class="w-full border p-3 rounded focus:border-[#427A43] outline-none">

      <input type="file" name="image" required
        class="w-full border p-3 rounded">

      <button type="submit"
        class="w-full bg-[#427A43] text-white p-3 rounded hover:bg-green-800">
        Upload
      </button>

    </form>

  </div>

</body>
</html>
