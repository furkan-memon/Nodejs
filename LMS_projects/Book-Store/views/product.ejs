<!DOCTYPE html>
<html>
<head>
  <title>All Books</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
</head>

<body class="bg-[#F2E3BB] p-10">

  <h1 class="text-3xl font-semibold text-[#427A43] mb-8">
    Uploaded Books
  </h1>

  <div class="flex shrink flex-wrap gap-8">

    <% product.forEach(product => { %>

      <div class="bg-white rounded-xl shadow-lg p-4">

        <img 
          src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
         class="w-full h-72 object-contain bg-[#F2E3BB] rounded"
        >

        <h2 class="text-lg font-semibold text-[#427A43]">
          <%= product.name %>
        </h2>

        <p class="text-gray-600">
          <%= product.authorname %>
        </p>

        <p class="font-bold mt-2">
          ₹<%= product.price %>
        </p>
        <div class="flex justify-between items-center mt-4">

  <a href="/admin/edit/<%= product._id %>"
     class="bg-[#427A43] text-white px-3 py-1 rounded-md text-sm  transition">
     Edit
  </a>

  <a href="/admin/delete/<%= product._id %>"
     class="bg-[#427A43] text-white px-3 py-1 rounded-md text-sm  transition">
     Delete
  </a>

</div>

      </div>

    <% }) %>

  </div>
<script src="https://unpkg.com/lucide@latest"></script>
</body>
</html>
