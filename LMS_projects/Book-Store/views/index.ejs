<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Bookstore Shop</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-[#F2E3BB] min-h-screen">

  <header class="bg-white shadow-sm">
    <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
      
      <h1 class="text-3xl font-semibold text-[#427A43]">Book Store</h1>

      <input 
        type="text" 
        placeholder="Search books..."
        class="border border-gray-300 rounded-lg px-4 py-2 w-64
               focus:outline-none focus:border-[#427A43]"
      >

      <a href="/cart" class="bg-[#427A43] text-white px-4 py-2 rounded-lg">
        Cart
      </a>

    </div>
  </header>

  <section class="max-w-6xl mx-auto px-6 py-10">

    <h1 class="text-3xl font-semibold text-[#427A43] mb-8">
      Explore Our Books
    </h1>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">

      <% product.forEach(product => { %>

        <div class="bg-white rounded-xl shadow-md hover:shadow-xl transition p-3 duration-300 overflow-hidden">

          <div class="h-72 flex items-center justify-center bg-[#F2E3BB]">
            <img 
              src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
              class="max-h-full object-contain"
            >
          </div>

          <div class="p-4 flex flex-col justify-between h-40">

            <div>
              <h2 class="font-semibold text-lg text-[#427A43] truncate">
                <%= product.name %>
              </h2>

              <p class="text-gray-600 text-sm mt-1 truncate">
                <%= product.authorname %>
              </p>
            </div>

            <div class="flex justify-between items-center mt-4">
              <span class="font-bold text-[#427A43] text-lg">
                ₹<%= product.price %>
              </span>

              <a href='/addtocart/<%= product._id%>' class="bg-[#427A43] text-white px-3 py-1 rounded-md text-sm hover:bg-green-800 transition">
                Add to Cart
              </a>
            </div>

          </div>

        </div>

      <% }) %>

    </div>

  </section>

</body>
</html>