 <%- include('layouts/header') %>
    <table>
      <tr>
        <th>Name</th>
        <th>Email</th>
      </tr>
      <% users.forEach(user=> { %>
        <tr>
          <td>
            <%= user.name %>
          </td>
          <td>
            <%= user.email %>
          </td>
        </tr>
        <% }) %>
    </table>
    <%- include('layouts/footer') %>