<%- include("partials/header", { title: "Add Task" }) %>
<%- include("partials/navbar", { user: user }) %>

<div class="flex justify-center mt-10">
    <div class="bg-white p-8 rounded-xl shadow w-96">

        <h2 class="text-xl font-bold mb-4 text-blue-600">Add Task</h2>

        <form method="POST" action="/taskForm" class="space-y-4">
            <input name="title" placeholder="Title"
                class="w-full px-3 py-2 border rounded focus:ring-2 focus:ring-blue-400" required>

            <input name="category" placeholder="Category"
                class="w-full px-3 py-2 border rounded focus:ring-2 focus:ring-blue-400" required>

            <button class="w-full bg-blue-500 text-white py-2 rounded hover:bg-blue-600">
                Add Task
            </button>
        </form>

    </div>
</div>

<%- include("partials/footer") %>