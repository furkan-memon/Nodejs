<%- include("partials/header", { title: "Edit Task" }) %>
<%- include("partials/navbar", { user: user }) %>

<div class="flex justify-center mt-10">
    <div class="bg-white p-8 rounded-xl shadow w-96">

        <h2 class="text-xl font-bold mb-4 text-yellow-500">
            Edit Task
        </h2>

        <form method="POST"
              action="/edit/<%= task._id %>"
              class="space-y-4">

            <input
                name="title"
                value="<%= task.title %>"
                placeholder="Title"
                class="w-full px-3 py-2 border rounded focus:ring-2 focus:ring-yellow-400"
                required
            >

            <input
                name="category"
                value="<%= task.category %>"
                placeholder="Category"
                class="w-full px-3 py-2 border rounded focus:ring-2 focus:ring-yellow-400"
                required
            >

            <div class="flex gap-2">
                <button
                    class="w-full bg-yellow-500 text-white py-2 rounded hover:bg-yellow-600">
                    Update Task
                </button>

                <a href="/taskList"
                   class="w-full text-center bg-gray-300 py-2 rounded hover:bg-gray-400">
                   Cancel
                </a>
            </div>

        </form>

    </div>
</div>

<%- include("partials/footer") %>