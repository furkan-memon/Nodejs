<%- include("partials/header", { title: "Task List" }) %>
<%- include("partials/navbar", { user: user }) %>

<div class="max-w-4xl mx-auto mt-8 bg-white p-6 rounded-xl shadow">

    <h2 class="text-2xl font-bold mb-4 text-blue-600">Task List</h2>

    <table class="w-full border">
        <thead class="bg-gray-200">
            <tr>
                <th class="p-2 text-left">Title</th>
                <th class="p-2 text-left">Category</th>
                <th class="p-2 text-left">Action</th>
            </tr>
        </thead>

        <tbody>
            <% data.forEach(task => { %>
                <tr class="border-t">
                    <td class="p-2"><%= task.title %></td>
                    <td class="p-2"><%= task.category %></td>
                    <td class="p-2 ">
                        <a href="/edit/<%= task._id %>" 
                            class="bg-green-500 text-white px-3 mr-3 py-1 rounded hover:bg-red-600">
                            Edit
                         </a>
                        <a href="/delete/<%= task._id %>" 
                           class="bg-red-500 text-white px-3 py-1 rounded hover:bg-red-600">
                           Delete
                        </a>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

</div>

<%- include("partials/footer") %>