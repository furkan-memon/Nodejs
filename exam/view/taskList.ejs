<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Tasks - Task Manager</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include("navbar") %>

    <div class="page-wrapper page-wrapper--wide">
        <div class="table-card">
            <div class="table-header">
                <h1>My Tasks</h1>
                <p>View and manage your personal tasks</p>
            </div>

            <div class="table-actions">
                <a href="/taskForm" class="btn btn-primary">Add New Task</a>
            </div>

            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Priority</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody class="task-list">
                        <tr class="empty-row">
                            <td colspan="3" class="empty-state">
                                <p>No tasks found. Create a new task to get started!</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        function deleteTask(id) {
            if (confirm("Are you sure you want to delete this task?")) {
                fetch("/delete/" + id, { method: "DELETE" })
                    .then(function(res) { return res.json(); })
                    .then(function() { window.location.reload(); })
                    .catch(function(err) { console.error("Error:", err); });
            }
        }

        function displayTasks(data) {
            var tbody = document.querySelector(".task-list");
            tbody.innerHTML = "";

            if (data.length === 0) {
                tbody.innerHTML = '<tr class="empty-row"><td colspan="3" class="empty-state"><p>No tasks found. Create a new task to get started!</p></td></tr>';
                return;
            }

            data.forEach(function(task) {
                var tr = document.createElement("tr");

                var tdTitle = document.createElement("td");
                tdTitle.textContent = task.title;

                var tdCategory = document.createElement("td");
                tdCategory.innerHTML = '<span class="badge badge-' + task.category + '">' + task.category + '</span>';

                var tdActions = document.createElement("td");
                tdActions.className = "action-buttons";

                var editBtn = document.createElement("button");
                editBtn.textContent = "Edit";
                editBtn.className = "btn btn-warning";
                editBtn.addEventListener("click", function() {
                    window.location.href = "/edit/" + task._id;
                });

                var deleteBtn = document.createElement("button");
                deleteBtn.textContent = "Delete";
                deleteBtn.className = "btn btn-danger";
                deleteBtn.addEventListener("click", function() {
                    deleteTask(task._id);
                });

                tdActions.appendChild(editBtn);
                tdActions.appendChild(deleteBtn);
                tr.appendChild(tdTitle);
                tr.appendChild(tdCategory);
                tr.appendChild(tdActions);
                tbody.appendChild(tr);
            });
        }

        function fetchTasks() {
            fetch("/mytask")
                .then(function(res) { return res.json(); })
                .then(function(data) { displayTasks(data); })
                .catch(function(err) {
                    console.error("Error:", err);
                    document.querySelector(".task-list").innerHTML = '<tr class="empty-row"><td colspan="3" class="empty-state"><p>Error loading tasks.</p></td></tr>';
                });
        }

        fetchTasks();
    </script>
</body>
</html>
